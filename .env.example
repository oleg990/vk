# Ключ доступа сообщества: Управление → Работа с API → Ключи доступа → Создать ключ.
# Права: «Управление сообществом» и «Сообщения сообщества». Никому не пересылать.
VK_TOKEN=

# ID группы «Олег Маханько | Недвижимость» (vk.ru/makhanko_nedvizhimost)
VK_GROUP_ID=241936618

# Твой VK id (число из vk.ru/id…): сюда приходят заявки, тебе доступны /команды.
# Перед запуском напиши любое сообщение в сообщения группы — иначе VK не даст боту писать тебе.
ADMIN_VK_ID=

# Ссылка на политику обработки персональных данных (показывается при запросе согласия)
PRIVACY_URL=

# Номер для кнопки «Позвонить Олегу»
CALL_PHONE=+79205952888

# Файл с диалогами, заявками и настройками
DATA_FILE=/opt/realty-bot/data/bot.json

TZ_NAME=Europe/Moscow

# Kandinsky (Fusion Brain) — бесплатная генерация фото: fusionbrain.ai → API
FB_KEY=
FB_SECRET=
# Pexels — бесплатный фотосток: pexels.com/api
PEXELS_KEY=
# Pixabay — бесплатный фотосток: pixabay.com/api/docs
PIXABAY_KEY=
# Задача Claude «сделай пост»: claude.ai/code/routines → API trigger
ROUTINE_ID=
ROUTINE_TOKEN=
